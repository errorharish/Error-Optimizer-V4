      "value": 1,
      "os": [
        "win10",
        "win11"
      ],
      "risk": "Low",
      "requiresConfirmation": false,
      "warning": "Prevents OneDrive from syncing in the background. Existing local files in %UserProfile%\\OneDrive are 100% preserved.",
      "conditions": [],
      "verification": "ReadBack",
      "rollback": "Snapshot",
      "description": "Disables background OneDrive file synchronization via policy without deleting or altering any existing local user documents."
    },
