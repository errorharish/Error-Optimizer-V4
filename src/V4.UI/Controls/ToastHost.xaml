<UserControl x:Class="V4.UI.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:V4.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="360"
             IsHitTestVisible="False"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="ToastCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10,16,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts, RelativeSource={RelativeSource AncestorType=local:ToastHost}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ToastItem}">
                <Border Style="{StaticResource ToastCardStyle}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="3,1,1,1"
                        Opacity="{Binding Opacity}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <TextBlock Grid.Column="0" Text="{Binding IconText}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{Binding AccentBrush}"
                                   VerticalAlignment="Top" Margin="0,1,12,0"/>

                        <!-- Title and Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="11" Foreground="#9CA3AF"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
