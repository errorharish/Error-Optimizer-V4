<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <AssemblyName>ErrorOptimizer</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2026.10.8.1421</Version>
    <FileVersion>2026.10.8.1421</FileVersion>
    <AssemblyVersion>2026.10.8.1421</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiosOptimizer.IPC\BiosOptimizer.IPC.csproj" />
    <ProjectReference Include="..\BiosOptimizer.Core\BiosOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\V4.UI\**\*.cs" Link="V4.UI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\V4.UI\**\*.xaml" Link="V4.UI\%(RecursiveDir)%(Filename)%(Extension)">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

</Project>
