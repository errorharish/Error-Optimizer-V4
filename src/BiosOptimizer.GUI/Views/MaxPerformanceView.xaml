<UserControl x:Class="BiosOptimizer.GUI.Views.MaxPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <!-- Workload Shield Banner -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <!-- Metrics Cards -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <!-- Actions Bar -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <!-- Candidate / Result Tabs & Details -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="V4 Maximum Performance" Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ADAPTIVE OPTIMIZER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Iterative background process reduction and gaming &amp; editing performance tuning. Adapts safely to your hardware drivers and active workloads."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Pill -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Workload & Safety Shield Banner -->
            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,14" Background="{StaticResource GlassCardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WorkloadDescription}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="System protection policy actively preserves Windows kernel, security, audio DACs, anti-cheat, hardware drivers, and editing render sessions."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Metrics Cards Grid -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Initial vs Current Processes Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PROCESS COUNT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CurrentProcessCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" active" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FormattedRamRecovered}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adaptive Target Range Card -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="SAFE TARGET RANGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SafeMinimumRangeText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" procs" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="Hardware-aware safe floor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Reducible Candidates Card -->
                <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="REDUCIBLE BACKGROUND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ReducibleProcessCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" items" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="Telemetry, updaters &amp; idle tasks" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Protected Subsystems Card -->
                <Border Grid.Column="6" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PROTECTED SUBSYSTEMS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ProtectedProcessCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text=" shielded" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="OS, Drivers &amp; Workloads" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Interactive Command Bar -->
            <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Adaptive Process Pipeline: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Scan → Classify → Plan → Backup → Apply → Re-scan → Verify → Measure" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ScanCommand}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Re-Scan System" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviewCommand}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Preview Plan" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RollbackCommand}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Rollback" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyOptimizationCommand}" Padding="18,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                <TextBlock Text="Optimize Maximum Performance" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Optimization Candidates & Action History Section -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Candidates Panel -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Optimization Candidates" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Verified non-essential items discovered for reduction" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" Background="{StaticResource InputBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConfidenceBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Actions & Verification History Panel -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Execution &amp; Verification State" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{Binding StopReason, TargetNullValue='No optimization run yet.'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl ItemsSource="{Binding ActionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" Background="{StaticResource InputBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TargetIdentifier}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ActionType}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding VerificationMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="{StaticResource SuccessSoftBrush}">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
