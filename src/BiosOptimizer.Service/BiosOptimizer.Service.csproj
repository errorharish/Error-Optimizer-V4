<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-BiosOptimizer.Service-a2097ee2-fca4-494e-82b4-852e7e15ae44</UserSecretsId>
    <AssemblyTitle>ERROR OPTIMIZER V4 Service</AssemblyTitle>
    <Product>ERROR OPTIMIZER V4</Product>
    <Company>Error Optimizer Team</Company>
    <Description>ERROR OPTIMIZER V4 Background Service</Description>
    <Version>4.0.5</Version>
    <FileVersion>4.0.5.0</FileVersion>
    <AssemblyVersion>4.0.5.0</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiosOptimizer.Core\BiosOptimizer.Core.csproj" />
    <ProjectReference Include="..\BiosOptimizer.Detection\BiosOptimizer.Detection.csproj" />
    <ProjectReference Include="..\BiosOptimizer.Safety\BiosOptimizer.Safety.csproj" />
    <ProjectReference Include="..\BiosOptimizer.IPC\BiosOptimizer.IPC.csproj" />
    <ProjectReference Include="..\BiosOptimizer.CLI\BiosOptimizer.CLI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
